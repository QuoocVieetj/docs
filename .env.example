# ============================================================
# CÁCH DÙNG
#   1. cp .env.example .env
#   2. Chọn DB ở mục 1 (mặc định là DB local, không cần sửa gì)
#   3. docker compose up -d --build
# File .env không được commit. Không ghi mật khẩu thật vào file này.
# ============================================================


# ============================================================
# 1. KẾT NỐI DATABASE  <-- chỉ cần sửa ở đây
# ============================================================

# --- Cách A: DB local trên máy bạn (mặc định, giữ nguyên) ---
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
# CATEGORY_DB_URL=jdbc:postgresql://postgres:5432/category_db

# --- Cách B: DB dùng chung qua Tailscale ---
# Xóa 4 dòng của Cách A, bỏ dấu # ở 4 dòng dưới, điền tài khoản được cấp:
DB_USERNAME=<tài khoản của bạn> (baohuy)
DB_PASSWORD=<mật khẩu của bạn>  (baohuy123)
AUTH_DB_URL=jdbc:postgresql://100.67.250.1:5432/auth_db (ví dụ)
CATEGORY_DB_URL=jdbc:postgresql://100.67.250.1:5432/category_db (ví dụ)

# Thêm service mới: thêm một dòng <TÊN>_DB_URL=.../<tên>_db cho cả hai cách.

# Các biến khác (Postgres local, MinIO, JWT...) đã có mặc định trong docker-compose.yml,
# chỉ thêm vào .env khi cần đổi.
