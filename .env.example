# Copy thành .env rồi sửa nếu cần: cp .env.example .env
# Các giá trị dưới đây chỉ dùng cho môi trường dev trên máy local.

# ============================================================
# Hạ tầng dùng chung
# ============================================================

# PostgreSQL trong compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Tài khoản các service dùng để kết nối DB.
# Dùng DB khác (postgres-shared qua Tailscale, Neon...) thì đổi theo tài khoản của DB đó.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MinIO (tệp đính kèm)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=attachments

# ============================================================
# auth-service (REST :8081, gRPC :9091)
# ============================================================

# "postgres" là tên service trong compose; dùng DB dùng chung thì đổi thành IP, vd 100.x.x.x
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
# Khóa ký JWT, tối thiểu 32 ký tự. Khi deploy bắt buộc tạo khóa mới: openssl rand -hex 32
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Tạo sẵn tài khoản mẫu (admin, manager, employee1...)
AUTH_SEED_ENABLED=true

# ============================================================
# category-service (REST :8080)
# ============================================================

CATEGORY_DB_URL=jdbc:postgresql://postgres:5432/category_db

# ============================================================
# front-end (:3000) - URL trình duyệt gọi tới các service
# ============================================================

VITE_API_BASE_URL=http://localhost:8081/api
VITE_CATEGORY_API_URL=http://localhost:8080/api
